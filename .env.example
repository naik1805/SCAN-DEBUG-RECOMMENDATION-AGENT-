# Scan Debug Recommendation Agent — copy to `.env` and adjust.
# Nothing deploy-sensitive should live in source; use these keys instead.

# API
API_HOST=127.0.0.1
API_PORT=8005

# UI (used for CORS derivation + root API link)
UI_HOST=127.0.0.1
UI_PORT=3001
UI_BASE_URL=http://127.0.0.1:3001
UI_DASHBOARD_PATH=/dashboard/recommendation-analysis

# Comma-separated. If empty, derived from UI_BASE_URL / UI_HOST / UI_PORT.
# CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# Data & model (absolute paths or relative to project)
# SCAN_DEBUG_DATA_DIR=
# STIL_FILENAME=Production_SCAN_stuck_at_1000pat.stil
# STIL_PATH=
# MODEL_WEIGHTS_PATH=

# Training
AUTO_TRAIN_ON_STARTUP=true
AUTO_TRAIN_EPISODES=500

# Dashboard
DASHBOARD_CACHE_TTL_SEC=90
TOP_RECOMMENDATIONS_LIMIT=20

# Domain thresholds
IR_DROP_MV_THRESHOLD=25
THERMAL_C_THRESHOLD=60
IR_NORMAL_THRESHOLD_MV=15
SCAN_CHAIN_HIGH_SIMILARITY=0.78
POWER_WORKSPACE_ROWS=400
DEFECT_WORKSPACE_ROWS=40

# Recommendations: ml (default) | kpi | hybrid
RECOMMENDATION_SOURCE=ml
ML_AUTO_TRAIN=true
ML_USE_FOR_API_RECOMMEND=true
# ML_MODEL_PATH=
APP_ENV=development
# APP_ENV=production
API_KEY=
# API_KEYS=key1,key2
REQUIRE_API_KEY=false
LOG_LEVEL=INFO
LOG_JSON=false
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_TRAIN_PER_MINUTE=5
DISABLE_OPENAPI=false
MAX_TRAIN_EPISODES=1000
STARTUP_WARM_CACHES=true
